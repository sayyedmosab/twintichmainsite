  "overlays": {
    "intro-1": {
      "h1": "تحويل تنفيذ الاستراتيجية",
      "h2": "التعقيد كأصل",
      "p": "تفشل معظم التحولات لأن التعقيد يطغى عليها. لقد حولنا هذا التعقيد إلى ميزة—وأعدنا تعريف التخطيط والمخاطر ولوحات المعلومات داخل نموذج متكامل واحد."
    },
    "intro-2": {
      "h1": "تخيل كونًا موازيًا",
      "h2": "حيث تسير التحولات بسلاسة",
      "p": "دعنا نريك أسبوعًا في ذلك الكون — أسبوع في حياة فريق التحول <b><a href=\"/assets/aweekin.mp4\">فيديو</a></b>. مستحيل؟ إنه هنا. بنينا النموذج الأولي: تطبيق Net.js مع قاعدة بيانات Supabase ومساعد Gemini، مبني على سيناريوهات مستوحاة من أحداث تحول حقيقية."
    },
    "intro-3": {
      "h1": "كيف فعلنا ذلك؟",
      "h2": "الأسئلة الصحيحة أولاً",
      "p": "قبل الإجابات، تحتاج إلى الأسئلة الصحيحة. تبدأ هذه الرحلة باكتشاف الأسئلة الأكثر أهمية—تلك التي تكشف كيف يعمل التعقيد حقًا."
    },
    "p23-your-org": {
      "h1": "تشريح المنظمة",
      "h2": "ما الذي يصنع المنظمة؟",
      "p": "أشياء كثيرة، مثل نظام حي من الأنظمة—استراتيجية، سياسات، عمليات، رقمية—تتأثر بقوى خارجية مثل الأسواق والأحداث العالمية. التحول الحقيقي يعني فهم كيفية تفاعل هذه المكونات، وليس التعامل معها بمعزل."
    },
    "p4-hidden": {
      "h1": "العلاقات الخفية",
      "h2": "إلى أي عمق تصل؟",
      "p": "لكل مكون مدخلاته ومخرجاته وروابطه الخفية مع الآخرين. عندما تُرسم هذه الروابط، تظهر أنماط—هيكل يوضح لماذا تؤثر التغييرات الصغيرة على النظام بأكمله."
    },
    "p56-where": {
      "h1": "لحظة الحقيقة",
      "h2": "هل يجب أن تسلك هذا الطريق؟",
      "p": "لقد فعلنا ذلك بالفعل—والإجابة نعم. لكن افعلها بعيون مفتوحة. التعقيد أعمق مما تتوقع، والإرشاد نادر. لهذا بنينا نموذجًا يلتقط الصورة الكاملة ويجعل الطريق قابلاً للتنقل."
    },
    "p7-two-years": {
      "h1": "أقفال في كل مكان",
      "h2": "ماذا كشفت سنتان؟",
      "p": "سنتان من العمل الدؤوب، فتحنا الحواجز واحدة تلو الأخرى. كل طبقة كشفت عن تبعيات جديدة، وكل مكعب أظهر روابط خفية. قطعة قطعة، تشكل التوأم الرقمي—خريطة حية للتعقيد. ومع اكتماله، قفز الذكاء الاصطناعي فجأة، وأصبح قويًا ومتوفراً، محولاً سنوات من الجهد إلى واقع عملي."
    },
    "p89-future": {
      "h1": "المستقبل جاهز اليوم",
      "h2": "أي طريق ستختار؟",
      "p": "مع اكتمال القطعة الأخيرة—قلب الحل—بث الذكاء الاصطناعي الحياة في التوأم الرقمي، مجددًا الأمل في تحول حقيقي. الرحلة لم تنتهِ لنا أو لك، بل تستمر عبر مركزين... مرر للأسفل للاستكشاف."
    },
